# -----------------------------------------------------------------------------
# InsightPilot Backend environment template
# Copy to .env for local development. Do not commit real secrets.
# -----------------------------------------------------------------------------

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inp

# JWT / Authentication Configuration
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=90
ALGORITHM=HS256
JWT_ALGORITHM=HS256
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=95

# Session Configuration (OAuth/session middleware)
SESSION_SECRET_KEY=change-me-to-another-long-random-secret

# Application Configuration
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000

# CORS Configuration (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security Configuration
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=8001

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Polar Configuration
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SUCCESS_URL=http://localhost:3000/dashboard/checkout/success?checkout_id={CHECKOUT_ID}
POLAR_SANDBOX=true
POLAR_SOLOPRENEUR_PRODUCT_ID=
POLAR_ENTREPRENEUR_PRODUCT_ID=

# Stripe Configuration (legacy routes)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# LLM Provider Configuration (provider priority: OpenRouter > ApiFreeLLM > GLM > Vultr)
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=deepseek/deepseek-r1-distill-llama-70b
APIFREELL_API_KEY=
APIFREELL_CHAT_MODEL=deepseek-r1-distill-llama-70b
GLM_API_KEY=
GLM_CHAT_MODEL=glm-4.5
VULTR_API_KEY=
